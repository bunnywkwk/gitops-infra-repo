# TEMPLATE FILE: DO NOT COMMIT REAL PASSWORDS TO GIT IN PLAINTEXT
# For local manual testing without Sealed Secrets, apply directly using kubectl:
# kubectl create secret generic postgres-secret --from-literal=POSTGRES_PASSWORD='your_secure_password'
